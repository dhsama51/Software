set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name SDC_FILE M3_demo.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 16

set_global_assignment -name LAST_QUARTUS_VERSION "21.1.0 Lite Edition"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_location_assignment PIN_L6 -to GPIO[0]
set_location_assignment PIN_N8 -to GPIO[1]
set_location_assignment PIN_P8 -to GPIO[2]
set_location_assignment PIN_P6 -to GPIO[3]
set_location_assignment PIN_N6 -to GPIO[4]
set_location_assignment PIN_N5 -to GPIO[5]
set_location_assignment PIN_P3 -to GPIO[6]
set_location_assignment PIN_N3 -to GPIO[7]
set_location_assignment PIN_L4 -to GPIO[8]
set_location_assignment PIN_L3 -to GPIO[9]
set_location_assignment PIN_T2 -to GPIO[10]
set_location_assignment PIN_R1 -to GPIO[11]
set_location_assignment PIN_P2 -to GPIO[12]
set_location_assignment PIN_P1 -to GPIO[13]
set_location_assignment PIN_N2 -to GPIO[14]
set_location_assignment PIN_N1 -to GPIO[15]

set_location_assignment PIN_D12 -to LED[0]
set_location_assignment PIN_C11 -to LED[1]
set_location_assignment PIN_B10 -to LED[2]
set_location_assignment PIN_B7 -to LED[3]

set_location_assignment PIN_E16 -to CLOCK_50
set_location_assignment PIN_G2 -to JOY_UP
set_location_assignment PIN_F1 -to JOY_DOWN
set_location_assignment PIN_F2 -to JOY_LEFT
set_location_assignment PIN_G1 -to JOY_RIGHT
set_location_assignment PIN_D1 -to JOY_PRESS

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
